  lines:
  - characterName: "\u30E4\u30AC\u30DF"
    face: {fileID: 21300000, guid: 9eb7cf94e98a17849accd6c97f3630e4, type: 3}
    message: "\u3053\u3093\u306B\u3061\u306F\u3001\u8077\u696D\u4F53\u9A13\u306E\u65B9\u3067\u3059\u3088\u306D\uFF01\r\n"
  - characterName: "\u30E4\u30AC\u30DF"
    face: {fileID: 21300000, guid: 9eb7cf94e98a17849accd6c97f3630e4, type: 3}
    message: "\u3088\u3046\u3053\u305D\u3001\u25CB\u25CB\u306E\u6383\u9664\u5C4B\u3053\u3068\u3007SW\u3078\uFF01\r\n"
  - characterName: "\u30E4\u30AC\u30DF"
    face: {fileID: 21300000, guid: b8132bed82cad43409152d7f3b2fcea5, type: 3}
    message: "\u6211\u3005\u306F\u3001\u66B4\u308C\u308B\u602A\u7363\u306E\u4F53\u5185\u306B\u5165\u308A\u3001\u66B4\u308C\u308B\u539F\u56E0\u3068\u306A\u308B\u3082\u306E\u306E\u6CBB\u7642\u3092\u3057\u307E\u3059\uFF01"
  - characterName: "\u30E4\u30AC\u30DF"
    face: {fileID: 21300000, guid: b8132bed82cad43409152d7f3b2fcea5, type: 3}
    message: "\u4ECA\u65E5\u306F\u3001\u4F53\u9A13\u3068\u3044\u3046\u3053\u3068\u3067\u3001\u98A8\u90AA\u3092\u3072\u3044\u3066\u66B4\u308C\u307E\u308F\u3063\u3066\u3044\u308B\u602A\u7363\u304C\u51FA\u73FE\u3057\u3066\u3044\u307E\u3059\u306E\u3067\u3001\u305D\u3061\u3089\u306E\u6CBB\u7642\u306B\u5411\u304B\u3044\u305F\u3044\u3068\u601D\u3044\u307E\u3059\uFF01"
  - characterName: "\u30E4\u30AC\u30DF"
    face: {fileID: 21300000, guid: 9eb7cf94e98a17849accd6c97f3630e4, type: 3}
    message: "\u3042\u3001\u7533\u3057\u9045\u308C\u307E\u3057\u305F\u3001\u79C1\u201D\u30E4\u30AC\u30DF\u201D\u3068\u7533\u3057\u307E\u3059\u3002\u9EBB\u9154\u79D1\u533B\u3092\u3057\u3066\u304A\u308A\u307E\u3059\u3002\u30B5\u30DD\u30FC\u30C8\u3092\u5916\u304B\u3089\u3057\u3066\u3044\u307E\u3059\u3002\r"
  - characterName: "\u30E4\u30AC\u30DF"
    face: {fileID: 21300000, guid: 9eb7cf94e98a17849accd6c97f3630e4, type: 3}
    message: "\u4F53\u5185\u306B\u5165\u308B\u306E\u306F\u3001\u968A\u9577\"\u30CA\u30CA\u30DB\u30B7\"\u3067\u3059\u3002\u5C0F\u3055\u3044\u3067\u3059\u304C\u3001\u982D\u306F\u3044\u3044\u306E\u3067\u5B89\u5FC3\u3057\u3066\u304F\u3060\u3055\u3044\uFF01\u3042\u306A\u305F\u306F\u3001\u30CA\u30CA\u30DB\u30B7\u3068\u4E00\u7DD2\u306B\u4F53\u5185\u306B\u5165\u3063\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3088\uFF01\r\n\r"
